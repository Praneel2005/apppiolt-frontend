# Copy to .env (never commit .env)
POSTGRES_PASSWORD=app
DATABASE_URL=postgresql://app:app@localhost:5432/appdb
DATABASE_URL_RO=postgresql://app_ro:app_ro@localhost:5432/appdb

# LLM (Gemini free tier). Get a key from Google AI Studio and choose the model name shown there.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
LLM_CACHE_DIR=.llm_cache
