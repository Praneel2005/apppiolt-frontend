# Copy to .env (never commit .env)
POSTGRES_PASSWORD=app
DATABASE_URL=postgresql://app:app@localhost:5432/appdb
DATABASE_URL_RO=postgresql://app_ro:app_ro@localhost:5432/appdb

# ---- LLM (all optional: with no key the agent still works on rules and deterministic composition)
# Primary provider: gemini | groq | openai_compat
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional stronger model used only to interpret analysis results (leave empty to reuse GEMINI_MODEL)
GEMINI_MODEL_STRONG=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_STRONG=
# Any OpenAI-compatible endpoint (OpenRouter, Together, DeepSeek, Cerebras, a local server, ...)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
# Failover: used automatically when the primary is rate limited or down. Defaults to the other provider whose key is set.
LLM_FALLBACK_PROVIDER=
LLM_TIMEOUT_S=30
LLM_CACHE_DIR=.llm_cache
